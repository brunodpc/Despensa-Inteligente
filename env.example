# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Use a Publishable key (sb_publishable_...) ou a chave anon legada.
# NUNCA coloque service_role/secret key em variáveis VITE_ ou no navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA
