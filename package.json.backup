  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android:add": "cap add android",
    "mobile:ios:add": "cap add ios",
    "mobile:android:open": "cap open android",
    "mobile:ios:open": "cap open ios",
    "mobile:android:sync": "npm run build && cap sync android",
    "mobile:ios:sync": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
